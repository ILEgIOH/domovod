# Скопируйте в .env для локальной разработки (переменные необязательны —
# без них приложение работает с тестовыми значениями по умолчанию).

# База данных (по умолчанию — локальный файл SQLite)
DATABASE_URL=sqlite:///domovod.db

# ЮKassa — по умолчанию используются публичные тестовые реквизиты ЮKassa
# (sandbox, без регистрации магазина, реальные деньги не списываются).
# Замените на свои боевые/тестовые реквизиты личного кабинета ЮKassa,
# когда будете готовы принимать настоящие платежи.
YOOKASSA_SHOP_ID=54401
YOOKASSA_SECRET_KEY=test_Fh8hUAVVBGUGbjmlzba6TB0iyUbos_lueTHE-axOwM0

# Публичный URL приложения (нужен для возврата после оплаты ЮKassa).
# На Render можно не задавать — используется RENDER_EXTERNAL_URL автоматически.
APP_BASE_URL=http://localhost:3000
